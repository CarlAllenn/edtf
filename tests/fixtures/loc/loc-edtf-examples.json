{
  "source": "https://www.loc.gov/standards/datetime/ — Extended Date/Time Format (EDTF) Specification, February 4, 2019 (page last updated 2022-02-02; examples transcribed 2026-07-26)",
  "note": "Every example string on the LoC EDTF specification page, verbatim, with the level LoC files it under. This is an interop cross-check corpus: where LoC and ISO 8601-2:2019 Annex A disagree, ISO wins and the divergence is recorded in docs/spec-notes.md (see D19, D20). 'level' is LoC's claimed level, which our ISO-derived classifier must match unless a divergence note says otherwise.",
  "examples": [
    { "edtf": "1985-04-12", "level": 0, "feature": "Date", "meaning": "calendar date, day precision" },
    { "edtf": "1985-04", "level": 0, "feature": "Date", "meaning": "reduced precision, month" },
    { "edtf": "1985", "level": 0, "feature": "Date", "meaning": "reduced precision, year" },
    { "edtf": "1985-04-12T23:20:30", "level": 0, "feature": "Date and Time", "meaning": "local time" },
    { "edtf": "1985-04-12T23:20:30Z", "level": 0, "feature": "Date and Time", "meaning": "UTC" },
    { "edtf": "1985-04-12T23:20:30-04", "level": 0, "feature": "Date and Time", "meaning": "shift in hours only" },
    { "edtf": "1985-04-12T23:20:30+04:30", "level": 0, "feature": "Date and Time", "meaning": "shift in hours and minutes" },
    { "edtf": "1964/2008", "level": 0, "feature": "Time Interval", "meaning": "year precision both ends" },
    { "edtf": "2004-06/2006-08", "level": 0, "feature": "Time Interval", "meaning": "month precision both ends" },
    { "edtf": "2004-02-01/2005-02-08", "level": 0, "feature": "Time Interval", "meaning": "day precision both ends" },
    { "edtf": "2004-02-01/2005-02", "level": 0, "feature": "Time Interval", "meaning": "day start, month end" },
    { "edtf": "2004-02-01/2005", "level": 0, "feature": "Time Interval", "meaning": "day start, year end" },
    { "edtf": "2005/2006-02", "level": 0, "feature": "Time Interval", "meaning": "year start, month end" },

    { "edtf": "Y170000002", "level": 1, "feature": "Letter-prefixed calendar year", "meaning": "the year 170000002" },
    { "edtf": "Y-170000002", "level": 1, "feature": "Letter-prefixed calendar year", "meaning": "the year -170000002" },
    { "edtf": "2001-21", "level": 1, "feature": "Seasons", "meaning": "Spring 2001" },
    { "edtf": "1984?", "level": 1, "feature": "Qualification of a date (complete)", "meaning": "year uncertain" },
    { "edtf": "2004-06~", "level": 1, "feature": "Qualification of a date (complete)", "meaning": "year-month approximate" },
    { "edtf": "2004-06-11%", "level": 1, "feature": "Qualification of a date (complete)", "meaning": "entire date uncertain and approximate" },
    { "edtf": "201X", "level": 1, "feature": "Unspecified digit(s) from the right", "meaning": "some year 2010-2019" },
    { "edtf": "20XX", "level": 1, "feature": "Unspecified digit(s) from the right", "meaning": "some year 2000-2099" },
    { "edtf": "2004-XX", "level": 1, "feature": "Unspecified digit(s) from the right", "meaning": "some month of 2004" },
    { "edtf": "1985-04-XX", "level": 1, "feature": "Unspecified digit(s) from the right", "meaning": "some day of 1985-04" },
    { "edtf": "1985-XX-XX", "level": 1, "feature": "Unspecified digit(s) from the right", "meaning": "some day of 1985" },
    { "edtf": "1985-04-12/..", "level": 1, "feature": "Extended Interval (L1)", "meaning": "open end, day-precision start" },
    { "edtf": "1985-04/..", "level": 1, "feature": "Extended Interval (L1)", "meaning": "open end, month-precision start" },
    { "edtf": "1985/..", "level": 1, "feature": "Extended Interval (L1)", "meaning": "open end, year-precision start" },
