    { "edtf": "../1985", "level": 1, "feature": "Extended Interval (L1)", "meaning": "open start, year-precision end" },
    { "edtf": "1985-04-12/", "level": 1, "feature": "Extended Interval (L1)", "meaning": "unknown end, day-precision start" },
    { "edtf": "1985-04/", "level": 1, "feature": "Extended Interval (L1)", "meaning": "unknown end, month-precision start" },
    { "edtf": "1985/", "level": 1, "feature": "Extended Interval (L1)", "meaning": "unknown end, year-precision start" },
    { "edtf": "/1985-04-12", "level": 1, "feature": "Extended Interval (L1)", "meaning": "unknown start, day-precision end" },
