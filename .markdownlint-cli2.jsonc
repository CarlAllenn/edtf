{
  // Max enforcement: every rule on. Line length is raised to 120 to match
  // yamllint; tables and code blocks are exempt (they can't be reflowed
  // without destroying them).
  "config": {
    "default": true,
    // Duplicate headings are only a defect among SIBLINGS. Changelogs are
    // generated by release-plz with a `### Other` (or `### Added`, `### Fixed`)
    // section per version, so the same sub-heading recurs under every `##
    // [x.y.z]` — legitimately, and not under our control. With the default
    // (document-wide) setting, the first release whose commits fell into an
    // already-used category turned every changelog red: v1.1.0 produced a
    // second `### Other` to sit alongside v1.0.0's, and CI failed on files
    // no human wrote. Sibling scope still catches the real error — the same
    // heading twice within one version.
    "no-duplicate-heading": { "siblings_only": true },
    "line-length": {
      "line_length": 120,
      "heading_line_length": 120,
      "tables": false,
      "code_blocks": false
    }
  },
  "globs": ["**/*.md"],
  // Build outputs and vendored trees are already gitignored per repo, so
  // honoring .gitignore keeps this file identical everywhere with no
  // repo-local ignore list.
  "gitignore": true,
  // .git/**: the glob engine traverses VCS internals, and the lefthook
  // remote cache (.git/info/lefthook-remotes/) contains markdown that isn't
  // ours to lint; .claude/** is machine-local session state.
  "ignores": [".git/**", ".claude/**"]
}
