target/
/crates/edtf-wasm/pkg/
.DS_Store
# ISO documents are copyrighted — never commit them
/spec/

# go-task fingerprint cache
.task/

# personal lefthook overrides — never committed
lefthook-local.yml

# Release staging: package-all.sh writes the .crate files here, and the
# extension tarballs and SHA256SUMS land beside them.
/dist/

# SBOM staging: cargo-cyclonedx has no output-directory flag, so the
# release step moves its output here out of the crate directories.
/sbom/

# Coverage staging: `task coverage` writes the lcov export here, and
# `task coverage:pg` the Postgres extension fragment beside it. Both are read
# by `task coverage:check`, so the glob has to stay narrow enough not to catch
# anything else.
/lcov.info
/lcov-postgres.info
/coverage-postgres.txt
biome-org.generated.json
