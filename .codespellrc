[codespell]
# Max enforcement: hidden files and filenames are checked, and the builtin
# dictionary set is widened beyond the default clear,rare. 'code' and
# 'names' stay off — they flag identifiers (uint, proper names) that are
# legitimate in codebases by design; dialect dictionaries off — the house
# dialect is en-GB and codespell has no en-US->en-GB dictionary (README.md
# in templates/linters/ of renovate-config).
builtin = clear,rare,informal,usage
# Boolean flags take an EMPTY value here: any value ("true") is forwarded
# to argparse as a stray positional argument and errors.
check-hidden =
check-filenames =
# .git must lead the skip list: check-hidden would otherwise descend it
# (the lefthook remote cache under .git/info/ contains prose that isn't
# ours). Repo-local entries follow, each with a reason.
skip = .git,target,mise.lock,Cargo.lock,tests/fixtures/legacy,spec,./fuzz/corpus,./fuzz/artifacts,./fuzz/target
# ignore-words-list is repo-local: add the key only when a repo needs it
# (an empty value is an argparse error), case-sensitive as written in the
# dictionary, keep minimal.
ignore-words-list = crate
