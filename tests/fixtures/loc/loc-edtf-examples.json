    { "edtf": "Y171010000S3", "level": 2, "feature": "Significant digits", "meaning": "per ISO 4.4.3: 171000000-171999999 (LoC agrees; ISO Annex A.6.3 Example 2 is the erratum, see D19)" },
    { "edtf": "Y3388E2S3", "level": 2, "feature": "Significant digits", "meaning": "338000-338999, estimated 338800" },
    { "edtf": "2001-34", "level": 2, "feature": "Sub-year groupings", "meaning": "second quarter of 2001" },
    { "edtf": "[1667,1668,1670..1672]", "level": 2, "feature": "Set representation", "meaning": "one of 1667, 1668, 1670..1672" },
    { "edtf": "[..1760-12-03]", "level": 2, "feature": "Set representation", "meaning": "1760-12-03 or earlier" },
    { "edtf": "[1760-12..]", "level": 2, "feature": "Set representation", "meaning": "1760-12 or some later month" },
    { "edtf": "[1760-01,1760-02,1760-12..]", "level": 2, "feature": "Set representation", "meaning": "Jan or Feb 1760, or Dec 1760 or later" },
    { "edtf": "[1667,1760-12]", "level": 2, "feature": "Set representation", "meaning": "1667 or 1760-12" },
    { "edtf": "[..1984]", "level": 2, "feature": "Set representation", "meaning": "1984 or earlier" },
    { "edtf": "{1667,1668,1670..1672}", "level": 2, "feature": "Set representation", "meaning": "all of 1667, 1668, 1670..1672" },
    { "edtf": "{1960,1961-12}", "level": 2, "feature": "Set representation", "meaning": "1960 and 1961-12" },
    { "edtf": "{..1984}", "level": 2, "feature": "Set representation", "meaning": "1984 and all earlier years" },
    { "edtf": "2004-06-11%", "level": 2, "feature": "Qualification (group)", "meaning": "listed again under L2 group qualification; trailing whole-expression qualifier is L1 in ISO terms (Annex A.3.1), so our classifier reports 1", "our_level": 1 },
    { "edtf": "2004-06~-11", "level": 2, "feature": "Qualification (group)", "meaning": "year and month approximate" },
    { "edtf": "2004?-06-11", "level": 2, "feature": "Qualification (group)", "meaning": "year uncertain" },
    { "edtf": "?2004-06-~11", "level": 2, "feature": "Qualification (individual)", "meaning": "year uncertain, day approximate" },
    { "edtf": "2004-%06-11", "level": 2, "feature": "Qualification (individual)", "meaning": "month uncertain and approximate" },
    { "edtf": "156X-12-25", "level": 2, "feature": "Unspecified Digit", "meaning": "Dec 25 sometime in the 1560s" },
    { "edtf": "15XX-12-25", "level": 2, "feature": "Unspecified Digit", "meaning": "Dec 25 sometime in the 1500s" },
    { "edtf": "XXXX-12-XX", "level": 2, "feature": "Unspecified Digit", "meaning": "some day in some December" },
    { "edtf": "1XXX-XX", "level": 2, "feature": "Unspecified Digit", "meaning": "some month during the 1000s" },
    { "edtf": "1XXX-12", "level": 2, "feature": "Unspecified Digit", "meaning": "some December during the 1000s" },
    { "edtf": "1984-1X", "level": 2, "feature": "Unspecified Digit", "meaning": "Oct, Nov or Dec 1984" },
    { "edtf": "2004-06-~01/2004-06-~20", "level": 2, "feature": "Interval", "meaning": "approx first through approx 20th of June 2004" },
    { "edtf": "2004-06-XX/2004-07-03", "level": 2, "feature": "Interval", "meaning": "unspecified June day through July 3" }
  ],
  "invalid": [
    { "edtf": "20050924T100000", "feature": "Extended format", "meaning": "basic format is explicitly not permitted" },
    { "edtf": "-Y170000002", "feature": "Letter-prefixed calendar year", "meaning": "the pre-2018 erratum form LoC corrected to Y-170000002" }
  ]
}
